# MTVA-Bench API keys: one per provider. Copy to .env and fill in the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SMALLEST_API_KEY=

# The benchmark data is a private Hugging Face dataset; this token needs read access to it.
HF_TOKEN=

# provider: custom names its own key variable with `api_key_env`, and may need none at all.
